        <div class="media-player-ad-video">



<div class="media-player-ad-video__container theme-media-player-ad--image-bkg-light" data-theme="image-bkg-light" data-autoid="" data-cmp-is="MediaPlayerAdVideo" data-cmp-data-layer="{&#34;media-player-ad-video-130454e2f3&#34;:{&#34;linkLabel&#34;:&#34;Explore IBM watsonx.data&#34;,&#34;linkNumber&#34;:1,&#34;mediaPlayerLink&#34;:&#34;https://www.ibm.com/products/watsonx-data&#34;,&#34;@type&#34;:&#34;adobe-cms/components/content/molecules/media-player-ad-video&#34;,&#34;ctaInXf&#34;:&#34;true&#34;,&#34;topic&#34;:&#34;Data management&#34;,&#34;eyebrowLabel&#34;:&#34;What is AI Data Management?&#34;,&#34;componentName&#34;:&#34;Media Player Ad - Video&#34;}}" data-attribute2="Data management" data-attribute1="media-player">
