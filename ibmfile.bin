    </div>



    

    <c4d-content-item-heading>
        


  
  
    
    Developers

  





    


    </c4d-content-item-heading>
    <c4d-content-item-paragraph>
        <div class="cms-richtext  " id="rich-text-e976c2e8ed" data-dynamic-inner-content="description">
    <p>Developers rely on vector databases for language-specific <a href="https://www.ibm.com/think/topics/api-vs-sdk" target="_self" rel="noopener noreferrer">software development kits</a> (SDKs) and predictable <a href="https://www.ibm.com/think/topics/api" target="_self" rel="noopener noreferrer">application programming interfaces</a> (APIs). Often, they’ll integrate vector search into applications such as chatbots and recommendation engines.</p>

    
    
    
    

</div>
    </c4d-content-item-paragraph>
    
</c4d-content-item>

    
    <script defer src="https://1.www.s81c.com/etc.clientlibs/adobe-cms/clientlibs/clientlib-content-item.lc-33c1d0a81cc2fc5cfdcbb018f5a9725b-lc.min.js"></script>


</div>
<div class="pictogram-item">
<c4d-content-item horizontal>
    
    
    <svg fill="currentColor" slot="media" class="build-and-deploy-pipeline  cds--pictogram-item__pictogram" data-autoid="c4d--pictogram-item__pictogram" focusable="false" viewBox="0 0 80 80" height="80" width="80" role="img">
        <use href="#build-and-deploy-pipeline" height="80" width="80"></use>
        <defs>
            <linearGradient id="pictogram-color-gradient-180-blue-to-purple-cd9d751e-d3ec-404c-9e94-e394901ef3fe" gradientTransform="rotate(90)">
                <stop offset="0%" stop-color="#0f62fe"/>
                <stop offset="100%" stop-color="#8a3ffc"/>
            </linearGradient>
            <linearGradient id="pictogram-color-gradient-180-blue-dark-to-light-cd9d751e-d3ec-404c-9e94-e394901ef3fe" gradientTransform="rotate(90)">
                <stop offset="0%" stop-color="#0f62fe"/>
                <stop offset="100%" stop-color="#78a9ff"/>
            </linearGradient>
            <linearGradient id="pictogram-color-gradient-180-blue-to-teal-cd9d751e-d3ec-404c-9e94-e394901ef3fe" gradientTransform="rotate(90)">
                <stop offset="0%" stop-color="#0f62fe"/>
                <stop offset="100%" stop-color="#08bdba"/>
            </linearGradient>
            <linearGradient id="pictogram-color-gradient-180-blue-to-magenta-cd9d751e-d3ec-404c-9e94-e394901ef3fe" gradientTransform="rotate(90)">
                <stop offset="0%" stop-color="#0f62fe"/>
                <stop offset="100%" stop-color="#ff7eb6"/>
            </linearGradient>
            <linearGradient id="pictogram-color-gradient-180-red-to-purple-cd9d751e-d3ec-404c-9e94-e394901ef3fe" gradientTransform="rotate(90)">
                <stop offset="0%" stop-color="#fa4d56"/>
                <stop offset="100%" stop-color="#a56eff"/>
